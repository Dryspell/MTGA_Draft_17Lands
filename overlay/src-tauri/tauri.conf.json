{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MTGA Draft Overlay",
  "version": "../package.json",
  "identifier": "com.mtgadraft.overlay",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MTGA Draft Overlay",
        "width": 420,
        "height": 720,
        "minWidth": 320,
        "minHeight": 300,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzQUEyMjE4OTY1ODM0MzAKUldRd05GaVdHQ0txczdpWlVlUVFkWEk1WVR2TjB6V1Ywa2kyKzZkV2V5RGFDakxXQTJrWmNYLzIK",
      "endpoints": ["https://github.com/Dryspell/MTGA_Draft_17Lands/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
