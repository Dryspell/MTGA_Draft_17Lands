{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MTGA Draft Overlay",
  "version": "0.1.0",
  "identifier": "com.mtgadraft.overlay",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MTGA Draft Overlay",
        "width": 420,
        "height": 720,
        "minWidth": 320,
        "minHeight": 300,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
